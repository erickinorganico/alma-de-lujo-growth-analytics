{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma-de-lujo.local/contracts/weekly-cycle-v1.schema.json",
  "title": "Immutable operating-cycle-v1 evidence and native-task exchange",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["merchandiser", "finance_analyst", "commerce_analyst", "returns_analyst", "growth_analyst", "market_researcher", "evidence_reviewer"]},
    "analyst_role": {"enum": ["merchandiser", "finance_analyst", "commerce_analyst", "returns_analyst", "growth_analyst", "market_researcher"]},
    "advisory_verdict": {"enum": ["READY_FOR_OWNER", "REVIEW", "BLOCKED"]},
    "agent_id": {"type": "string", "pattern": "^/root/[a-z0-9_/-]{1,120}$"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "local_ref": {"type": "string", "pattern": "^/(?:[^~]|~[01])*$", "maxLength": 500},
    "fact": {
      "type": "object", "required": ["id", "statement", "kind", "evidence_refs", "value"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 80}, "statement": {"type": "string", "minLength": 1, "maxLength": 4000}, "kind": {"enum": ["observation", "inference"]}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/local_ref"}}, "value": {}},
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object", "required": ["id", "action", "evidence_refs", "primary_metric", "guardrail", "population", "window", "closure_rule", "approval_required", "execution"],
      "properties": {"id": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/local_ref"}}, "primary_metric": {"type": "string", "minLength": 1}, "guardrail": {"type": "string", "minLength": 1}, "population": {"type": "string", "minLength": 1}, "window": {"type": "string", "minLength": 1}, "closure_rule": {"type": "string", "minLength": 1}, "approval_required": {"const": true}, "execution": {"const": "PROHIBITED"}},
      "additionalProperties": false
    },
    "accepted_hash_entry": {
      "type": "object",
      "required": ["request_id", "response_sha256", "query_trace_sha256", "dispatch_sha256", "agent_id", "model", "verdict"],
      "properties": {
        "request_id": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "query_trace_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_sha256": {"$ref": "#/$defs/sha256"},
        "agent_id": {"$ref": "#/$defs/agent_id"},
        "model": {"$ref": "#/$defs/model_id"},
        "verdict": {"$ref": "#/$defs/advisory_verdict"}
      },
      "additionalProperties": false
    },
    "analysis_summary": {
      "type": "object",
      "required": ["role", "summary", "verdict", "request_id", "response_sha256", "query_trace_sha256", "dispatch_sha256", "agent_id", "model"],
      "properties": {
        "role": {"$ref": "#/$defs/analyst_role"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
        "verdict": {"$ref": "#/$defs/advisory_verdict"},
        "request_id": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "query_trace_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_sha256": {"$ref": "#/$defs/sha256"},
        "agent_id": {"$ref": "#/$defs/agent_id"},
        "model": {"$ref": "#/$defs/model_id"}
      },
      "additionalProperties": false
    },
    "role_fact": {
      "type": "object",
      "required": ["role", "item"],
      "properties": {"role": {"$ref": "#/$defs/analyst_role"}, "item": {"$ref": "#/$defs/fact"}},
      "additionalProperties": false
    },
    "role_string": {
      "type": "object",
      "required": ["role", "item"],
      "properties": {"role": {"$ref": "#/$defs/role"}, "item": {"type": "string", "minLength": 1, "maxLength": 4000}},
      "additionalProperties": false
    },
    "analyst_role_string": {
      "type": "object",
      "required": ["role", "item"],
      "properties": {"role": {"$ref": "#/$defs/analyst_role"}, "item": {"type": "string", "minLength": 1, "maxLength": 4000}},
      "additionalProperties": false
    },
    "role_recommendation": {
      "type": "object",
      "required": ["role", "item"],
      "properties": {"role": {"$ref": "#/$defs/analyst_role"}, "item": {"$ref": "#/$defs/recommendation"}},
      "additionalProperties": false
    },
    "decision_anchor": {
      "type": "object",
      "required": ["version", "register_id", "terminal_hash", "event_count", "origins_hash"],
      "properties": {
        "version": {"const": "decision-register-v1"},
        "register_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
        "terminal_hash": {"oneOf": [{"const": "GENESIS"}, {"$ref": "#/$defs/sha256"}]},
        "event_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "origins_hash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "decision_binding": {
      "type": "object",
      "required": ["version", "register_id", "prior_anchor", "anchor"],
      "properties": {
        "version": {"const": "decision-register-v1"},
        "register_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
        "prior_anchor": {"$ref": "#/$defs/decision_anchor"},
        "anchor": {"$ref": "#/$defs/decision_anchor"}
      },
      "additionalProperties": false
    },
    "carried_decision": {
      "type": "object",
      "required": ["decision_id", "recommendation_id", "owner", "due_date", "status", "source_hash", "packet_hash", "event_count", "terminal_hash"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^dec-[0-9a-f]{24}$"},
        "recommendation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "due_date": {"type": "string", "format": "date"},
        "status": {"enum": ["OPEN", "IN_PROGRESS", "REVIEW", "STALE"]},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "packet_hash": {"$ref": "#/$defs/sha256"},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "terminal_hash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "registered_query": {
      "type": "object", "required": ["query_id", "question", "parameters", "result_refs", "row_count"],
      "properties": {"query_id": {"const": "metric_rows.by_reconciliation_id"}, "question": {"type": "string", "minLength": 1, "maxLength": 1000}, "parameters": {"type": "object", "required": ["reconciliation_id"], "properties": {"reconciliation_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "result_refs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/local_ref"}}, "row_count": {"type": "integer", "minimum": 1, "maximum": 100}},
      "additionalProperties": false
    },
    "current_cut": {
      "type": "object",
      "required": ["version", "cut_id", "cutoff_at", "timezone", "input_class", "synthetic_business_data", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "source_sha256", "coverage", "quality", "reconciliation", "lineage", "manifest", "mart_manifest", "metric_definitions", "semantic_catalog", "domain_coverage", "metric_rows", "families", "exceptions", "sales_readiness", "task_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "cut_id": {"$ref": "#/$defs/sha256"}, "cutoff_at": {"type": "string"}, "timezone": {"type": "string"}, "input_class": {"type": "string"}, "synthetic_business_data": {"type": "boolean"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"type": "object"}, "coverage": {"type": "object"}, "quality": {"type": "object"}, "reconciliation": {"type": "object"}, "lineage": {"type": "object"}, "manifest": {"type": "object"}, "mart_manifest": {"type": "object"}, "metric_definitions": {"type": "object"}, "semantic_catalog": {"type": "object"}, "domain_coverage": {"type": "object"}, "metric_rows": {"type": "array"}, "families": {"type": "object"}, "exceptions": {"type": "array"}, "sales_readiness": {"type": "array"}, "task_scope": {"type": "array", "items": {"$ref": "#/$defs/role"}}, "decision_register": {"$ref": "#/$defs/decision_binding"}, "carried_decisions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/carried_decision"}}},
      "dependentRequired": {"decision_register": ["carried_decisions"], "carried_decisions": ["decision_register"]},
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["version", "request_id", "cut_id", "run_id", "role", "expected_model_family", "execution_mode", "synthetic_business_data", "evidence_status", "blocked_sources", "current_cut_sha256", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "evidence_hash", "evidence", "evidence_refs", "registered_queries", "response_contract", "write_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "cut_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}, "role": {"$ref": "#/$defs/role"}, "expected_model_family": {"enum": ["terra", "luna", "sol", "astra"]}, "execution_mode": {"const": "native-codex-task-bridge"}, "synthetic_business_data": {"type": "boolean"}, "evidence_status": {"enum": ["READY_FOR_ANALYSIS", "REVIEW", "BLOCKED_EVIDENCE"]}, "blocked_sources": {"type": "array", "items": {"type": "string"}}, "current_cut_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "evidence_hash": {"$ref": "#/$defs/sha256"}, "evidence": {"type": "object"}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "minItems": 1}, "registered_queries": {"type": "object"}, "response_contract": {"const": "contracts/weekly-cycle-v1.schema.json#/$defs/response"}, "write_scope": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["version", "request_id", "role", "cut_id", "run_id", "evidence_hash", "current_cut_sha256", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "summary", "facts", "unknowns", "hypotheses", "recommendations", "challenges", "verdict"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "cut_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string"}, "evidence_hash": {"$ref": "#/$defs/sha256"}, "current_cut_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "summary": {"type": "string", "maxLength": 12000}, "facts": {"type": "array", "minItems": 2, "maxItems": 30, "items": {"$ref": "#/$defs/fact"}}, "unknowns": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string"}}, "hypotheses": {"type": "array", "maxItems": 30, "items": {"type": "string"}}, "recommendations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/recommendation"}}, "challenges": {"type": "array", "maxItems": 30, "items": {"type": "string"}}, "verdict": {"enum": ["REVIEW", "BLOCKED", "READY_FOR_OWNER"]}},
      "additionalProperties": false
    },
    "query_trace": {
      "type": "object",
      "required": ["version", "request_id", "role", "queries", "unavailable_reason"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "queries": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/registered_query"}}, "unavailable_reason": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "dispatch_receipt": {
      "type": "object",
      "required": ["version", "request_id", "role", "provider", "model", "agent_id", "effort", "started_at_utc", "completed_at_utc", "response_sha256", "query_trace_sha256", "recorded_by", "mode", "parent_validation_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "provider": {"const": "native-codex"}, "model": {"type": "string"}, "agent_id": {"type": "string"}, "effort": {"type": "string"}, "started_at_utc": {"type": "string", "format": "date-time"}, "completed_at_utc": {"type": "string", "format": "date-time"}, "response_sha256": {"$ref": "#/$defs/sha256"}, "query_trace_sha256": {"$ref": "#/$defs/sha256"}, "recorded_by": {"const": "parent-runtime"}, "mode": {"const": "live"}, "parent_validation_scope": {"type": "string"}},
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": ["version", "cut_id", "run_id", "status", "synthetic_business_data", "current_cut_sha256", "facts", "unknowns", "hypotheses", "recommendations", "challenges", "analyses", "review", "provenance", "external_execution"],
      "properties": {
        "version": {"const": "operating-cycle-v1"},
        "cut_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "status": {"$ref": "#/$defs/advisory_verdict"},
        "synthetic_business_data": {"type": "boolean"},
        "current_cut_sha256": {"$ref": "#/$defs/sha256"},
        "facts": {"type": "array", "minItems": 2, "maxItems": 180, "items": {"$ref": "#/$defs/role_fact"}},
        "unknowns": {"type": "array", "minItems": 1, "maxItems": 180, "items": {"$ref": "#/$defs/analyst_role_string"}},
        "hypotheses": {"type": "array", "maxItems": 180, "items": {"$ref": "#/$defs/analyst_role_string"}},
        "recommendations": {"type": "array", "maxItems": 72, "items": {"$ref": "#/$defs/role_recommendation"}},
        "challenges": {"type": "array", "maxItems": 210, "items": {"$ref": "#/$defs/role_string"}},
        "analyses": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/analysis_summary"}},
        "review": {
          "type": "object",
          "required": ["summary", "verdict", "facts", "unknowns", "hypotheses", "recommendations", "challenges", "request_id", "response_sha256", "query_trace_sha256", "dispatch_sha256", "agent_id", "model"],
          "properties": {
            "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
            "verdict": {"$ref": "#/$defs/advisory_verdict"},
            "facts": {"type": "array", "minItems": 2, "maxItems": 30, "items": {"$ref": "#/$defs/fact"}},
            "unknowns": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
            "hypotheses": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
            "recommendations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/recommendation"}},
            "challenges": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
            "request_id": {"$ref": "#/$defs/sha256"},
            "response_sha256": {"$ref": "#/$defs/sha256"},
            "query_trace_sha256": {"$ref": "#/$defs/sha256"},
            "dispatch_sha256": {"$ref": "#/$defs/sha256"},
            "agent_id": {"$ref": "#/$defs/agent_id"},
            "model": {"$ref": "#/$defs/model_id"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "source_sha256", "accepted_hashes", "review_hashes"],
          "properties": {
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "mart_bundle_sha256": {"$ref": "#/$defs/sha256"},
            "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
            "source_sha256": {"type": "object", "minProperties": 1, "maxProperties": 100, "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"}, "additionalProperties": {"$ref": "#/$defs/sha256"}},
            "accepted_hashes": {"type": "object", "minProperties": 1, "maxProperties": 6, "propertyNames": {"$ref": "#/$defs/analyst_role"}, "additionalProperties": {"$ref": "#/$defs/accepted_hash_entry"}},
            "review_hashes": {"$ref": "#/$defs/accepted_hash_entry"}
          },
          "additionalProperties": false
        },
        "external_execution": {"const": "PROHIBITED"}
      },
      "additionalProperties": false
    }
  }
}
