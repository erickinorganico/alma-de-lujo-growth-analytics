{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma-de-lujo.local/contracts/weekly-cycle-v1.schema.json",
  "title": "Immutable operating-cycle-v1 evidence and native-task exchange",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["merchandiser", "finance_analyst", "commerce_analyst", "returns_analyst", "growth_analyst", "market_researcher", "evidence_reviewer"]},
    "local_ref": {"type": "string", "pattern": "^/(?:[^~]|~[01])*$", "maxLength": 500},
    "fact": {
      "type": "object", "required": ["id", "statement", "kind", "evidence_refs", "value"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 80}, "statement": {"type": "string", "minLength": 1, "maxLength": 4000}, "kind": {"enum": ["observation", "inference"]}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/local_ref"}}, "value": {}},
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object", "required": ["id", "action", "evidence_refs", "primary_metric", "guardrail", "population", "window", "closure_rule", "approval_required", "execution"],
      "properties": {"id": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/local_ref"}}, "primary_metric": {"type": "string", "minLength": 1}, "guardrail": {"type": "string", "minLength": 1}, "population": {"type": "string", "minLength": 1}, "window": {"type": "string", "minLength": 1}, "closure_rule": {"type": "string", "minLength": 1}, "approval_required": {"const": true}, "execution": {"const": "PROHIBITED"}},
      "additionalProperties": false
    },
    "registered_query": {
      "type": "object", "required": ["query_id", "question", "parameters", "result_refs", "row_count"],
      "properties": {"query_id": {"const": "metric_rows.by_reconciliation_id"}, "question": {"type": "string", "minLength": 1, "maxLength": 1000}, "parameters": {"type": "object", "required": ["reconciliation_id"], "properties": {"reconciliation_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "result_refs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/local_ref"}}, "row_count": {"type": "integer", "minimum": 1, "maximum": 100}},
      "additionalProperties": false
    },
    "current_cut": {
      "type": "object",
      "required": ["version", "cut_id", "cutoff_at", "timezone", "input_class", "synthetic_business_data", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "source_sha256", "coverage", "quality", "reconciliation", "lineage", "manifest", "mart_manifest", "metric_definitions", "semantic_catalog", "domain_coverage", "metric_rows", "families", "exceptions", "sales_readiness", "task_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "cut_id": {"$ref": "#/$defs/sha256"}, "cutoff_at": {"type": "string"}, "timezone": {"type": "string"}, "input_class": {"type": "string"}, "synthetic_business_data": {"type": "boolean"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"type": "object"}, "coverage": {"type": "object"}, "quality": {"type": "object"}, "reconciliation": {"type": "object"}, "lineage": {"type": "object"}, "manifest": {"type": "object"}, "mart_manifest": {"type": "object"}, "metric_definitions": {"type": "object"}, "semantic_catalog": {"type": "object"}, "domain_coverage": {"type": "object"}, "metric_rows": {"type": "array"}, "families": {"type": "object"}, "exceptions": {"type": "array"}, "sales_readiness": {"type": "array"}, "task_scope": {"type": "array", "items": {"$ref": "#/$defs/role"}}},
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["version", "request_id", "cut_id", "run_id", "role", "expected_model_family", "execution_mode", "synthetic_business_data", "evidence_status", "blocked_sources", "current_cut_sha256", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "evidence_hash", "evidence", "evidence_refs", "registered_queries", "response_contract", "write_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "cut_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}, "role": {"$ref": "#/$defs/role"}, "expected_model_family": {"enum": ["terra", "luna", "sol", "astra"]}, "execution_mode": {"const": "native-codex-task-bridge"}, "synthetic_business_data": {"type": "boolean"}, "evidence_status": {"enum": ["READY_FOR_ANALYSIS", "REVIEW", "BLOCKED_EVIDENCE"]}, "blocked_sources": {"type": "array", "items": {"type": "string"}}, "current_cut_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "evidence_hash": {"$ref": "#/$defs/sha256"}, "evidence": {"type": "object"}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "minItems": 1}, "registered_queries": {"type": "object"}, "response_contract": {"const": "contracts/weekly-cycle-v1.schema.json#/$defs/response"}, "write_scope": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["version", "request_id", "role", "cut_id", "run_id", "evidence_hash", "current_cut_sha256", "manifest_sha256", "mart_bundle_sha256", "metric_contract_sha256", "summary", "facts", "unknowns", "hypotheses", "recommendations", "challenges", "verdict"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "cut_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string"}, "evidence_hash": {"$ref": "#/$defs/sha256"}, "current_cut_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "mart_bundle_sha256": {"$ref": "#/$defs/sha256"}, "metric_contract_sha256": {"$ref": "#/$defs/sha256"}, "summary": {"type": "string", "maxLength": 12000}, "facts": {"type": "array", "minItems": 2, "maxItems": 30, "items": {"$ref": "#/$defs/fact"}}, "unknowns": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string"}}, "hypotheses": {"type": "array", "maxItems": 30, "items": {"type": "string"}}, "recommendations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/recommendation"}}, "challenges": {"type": "array", "maxItems": 30, "items": {"type": "string"}}, "verdict": {"enum": ["REVIEW", "BLOCKED", "READY_FOR_OWNER"]}},
      "additionalProperties": false
    },
    "query_trace": {
      "type": "object",
      "required": ["version", "request_id", "role", "queries", "unavailable_reason"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "queries": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/registered_query"}}, "unavailable_reason": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "dispatch_receipt": {
      "type": "object",
      "required": ["version", "request_id", "role", "provider", "model", "agent_id", "effort", "started_at_utc", "completed_at_utc", "response_sha256", "query_trace_sha256", "recorded_by", "mode", "parent_validation_scope"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "request_id": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/role"}, "provider": {"const": "native-codex"}, "model": {"type": "string"}, "agent_id": {"type": "string"}, "effort": {"type": "string"}, "started_at_utc": {"type": "string", "format": "date-time"}, "completed_at_utc": {"type": "string", "format": "date-time"}, "response_sha256": {"$ref": "#/$defs/sha256"}, "query_trace_sha256": {"$ref": "#/$defs/sha256"}, "recorded_by": {"const": "parent-runtime"}, "mode": {"const": "live"}, "parent_validation_scope": {"type": "string"}},
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": ["version", "cut_id", "run_id", "status", "analyses", "review", "recommendations", "evidence_hashes"],
      "properties": {"version": {"const": "operating-cycle-v1"}, "cut_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string"}, "status": {"enum": ["READY_FOR_OWNER", "REVIEW", "BLOCKED"]}, "analyses": {"type": "array"}, "review": {"type": "object"}, "recommendations": {"type": "array"}, "evidence_hashes": {"type": "object"}},
      "additionalProperties": false
    }
  }
}
